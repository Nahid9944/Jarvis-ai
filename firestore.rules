rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidTimestamp(val) {
      return val is timestamp && val <= request.time;
    }

    function isValidUser(data, userId) {
      return data.userId == userId &&
             data.userId is string &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidMemory(data, userId) {
      return data.userId == userId &&
             data.userId is string &&
             data.key is string && data.key.size() > 0 &&
             data.content is string &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidTask(data, userId) {
      return data.userId == userId &&
             data.userId is string &&
             data.title is string && data.title.size() > 0 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidNote(data, userId) {
      return data.userId == userId &&
             data.userId is string &&
             data.title is string && data.title.size() > 0 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidCharacterProfile(data, userId) {
      return data.userId == userId &&
             data.userId is string &&
             data.modeId is string && data.modeId.size() > 0 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(request.resource.data, userId);
      allow update: if isOwner(userId) && isValidUser(request.resource.data, userId) &&
                    request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner(userId);

      match /memories/{memoryId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidMemory(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidMemory(request.resource.data, userId) &&
                      request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isOwner(userId);
      }

      match /tasks/{taskId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidTask(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidTask(request.resource.data, userId) &&
                      request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isOwner(userId);
      }

      match /notes/{noteId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidNote(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidNote(request.resource.data, userId) &&
                      request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isOwner(userId);
      }

      match /character_profiles/{profileId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidCharacterProfile(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidCharacterProfile(request.resource.data, userId) &&
                      request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isOwner(userId);
      }
    }
  }
}
